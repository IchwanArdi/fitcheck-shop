# Database Credentials (e.g. Supabase, Neon, PostgreSQL)
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# =========================================================================
# MIDTRANS ENVIRONMENT CONFIGURATION
# =========================================================================

# --- SANDBOX (Testing) ---
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=Mxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxx
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxx
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- PRODUCTION (Live) ---
# MIDTRANS_IS_PRODUCTION=true
# NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=true
# MIDTRANS_MERCHANT_ID=Mxxxxxxxx
# MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxx
# MIDTRANS_SERVER_KEY=Mid-server-xxxxxxx
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxx
# NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app
